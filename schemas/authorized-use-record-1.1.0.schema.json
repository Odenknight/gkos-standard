{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/authorized-use-record-1.1.0.schema.json",
  "title": "GKX Layer-7 Authorized Use Record 1.1.0",
  "description": "R26-S01 (accepted 2026-10-07; v0.83 development line; unpublished). The one current Authorized Use Record schema on the v0.83 line, built from the R17 candidate (schema_version 1.1.0-development) with required revocation_checks (R26-S01). The R26-A04 rules for which checks are required stay proposed. The v0.80 schema and the R17 candidate stay valid for historical records.",
  "type": "object",
  "required": [
    "canonical_profile", "artifact_type", "schema_version",
    "record_id", "record_version", "action_class", "purpose",
    "context_manifest_ref", "policy_ref", "compiler_ref",
    "proposing_actor", "authorizing_actor", "executing_actor",
    "delegation_chain", "requested_effect_scope", "authorized_effect_scope",
    "authority_basis_ref", "authority_evaluated_at", "authority_validity_result",
    "revocation_checks", "acted_at", "outcome", "recovery_route"
  ],
  "properties": {
    "canonical_profile": { "const": "GKX-CBOR-1" },
    "artifact_type": { "const": "authorized-use-record" },
    "schema_version": { "const": "1.1.0" },
    "record_id": { "type": "string", "minLength": 1 },
    "record_version": { "type": "string", "minLength": 1 },
    "action_class": { "type": "string", "minLength": 1 },
    "action_detail": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "context_manifest_ref": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" },
    "policy_ref": { "$ref": "gkx-common.defs.json#/$defs/componentReference" },
    "compiler_ref": { "$ref": "gkx-common.defs.json#/$defs/componentReference" },
    "proposing_actor": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "reviewing_actor": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "authorizing_actor": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "executing_actor": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "delegation_chain": {
      "type": "array",
      "description": "Ordered from originating authority through the final grantee.",
      "items": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" }
    },
    "requested_effect_scope": { "$ref": "gkx-common.defs.json#/$defs/effectScope" },
    "authorized_effect_scope": { "$ref": "gkx-common.defs.json#/$defs/effectScope" },
    "authority_basis_ref": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" },
    "authority_evaluated_at": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
    "authority_validity_result": { "const": "valid" },
    "revocation_checks": {
      "type": "array",
      "minItems": 1,
      "description": "R26-S01: the revocation checks this record relied on at the final admission or commit boundary, one per receipt in the delegation chain. Whether every receipt is covered and each check is within the policy-declared maximum age is a semantic check under R26-A04, which stays proposed.",
      "items": { "$ref": "#/$defs/revocationCheck" }
    },
    "acted_at": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
    "outcome": { "type": "string", "enum": ["completed", "refused", "failed", "partial"] },
    "external_receipt_ref": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" },
    "recovery_route": {
      "type": "object",
      "required": ["kind", "procedure_ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["correction", "compensation", "rollback", "escalation"] },
        "procedure_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "revocationCheck": {
      "type": "object",
      "required": ["receipt_ref", "status", "checked_at", "method"],
      "properties": {
        "receipt_ref": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" },
        "status": { "type": "string", "enum": ["not-revoked", "revoked", "indeterminate"] },
        "checked_at": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
        "method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
