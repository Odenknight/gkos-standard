{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.dev/schemas/provisional/l3/l3-interoperability-0.1-proposed.json",
  "title": "GKOS Layer-3 Interoperability Candidate 0.1",
  "description": "Provisional, non-normative candidate contract supporting Proposed R23. It does not amend GKOS v0.81 or establish conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "subject_ref", "relation", "object_ref", "provenance"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "subject_ref": {"$ref": "#/$defs/reference"},
    "relation": {"$ref": "#/$defs/relation"},
    "object_ref": {"$ref": "#/$defs/reference"},
    "actor_ref": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "scope": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "epistemic_state": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_record_refs"],
      "properties": {
        "source_record_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "resolution_state": {
      "type": "string",
      "enum": ["resolved", "unresolved", "ambiguous"]
    },
    "extension": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["gkos_uid", "uri", "alias", "path", "basename"]
        },
        "value": {"type": "string", "minLength": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "properties"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directed": {"type": "boolean"},
            "inverse_of": {"type": ["string", "null"]},
            "symmetric": {"type": "boolean"},
            "antisymmetric": {"type": "boolean"},
            "acyclic": {"type": "boolean"},
            "branching_permitted": {"type": "boolean"},
            "target_resolution_required": {"type": "boolean"}
          }
        }
      }
    }
  }
}
