{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/selection-set-1.1.0.schema.json",
  "title": "GKX Layer-6 selection envelope 1.1.0",
  "description": "R26-S03 and R26-A06 (proposed; v0.83 development line; unpublished). Selection envelope 1.0.0 with member, known-omission and closure-input object_ref allowed to use either digest form (artifactReferenceAnyDigest): a GKX-CBOR-1 digest for a canonical GKOS artifact, or a received-bytes digest for content that is not one. Selection envelope 1.0.0 stays valid for historical and published envelopes. The reference runner assembles a 1.1.0 envelope by recomputing every digest over the bytes its basis names.",
  "type": "object",
  "required": [
    "canonical_profile",
    "artifact_type",
    "schema_version",
    "selection_set_id",
    "selection_set_version",
    "purpose",
    "recipient",
    "selected_by",
    "eligible_snapshot_ref",
    "selection_policy_ref",
    "selected_at",
    "members",
    "known_omissions",
    "closure_inputs"
  ],
  "properties": {
    "canonical_profile": {
      "const": "GKX-CBOR-1"
    },
    "artifact_type": {
      "const": "selection-envelope"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "selection_set_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_set_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "authorized_scope": {
      "$ref": "gkx-common.defs.json#/$defs/effectScope"
    },
    "query_or_instruction": {
      "type": "string"
    },
    "selected_by": {
      "$ref": "gkx-common.defs.json#/$defs/actorReference"
    },
    "selector_ref": {
      "$ref": "gkx-common.defs.json#/$defs/componentReference"
    },
    "eligible_snapshot_ref": {
      "$ref": "gkx-common.defs.json#/$defs/artifactReference"
    },
    "selection_policy_ref": {
      "$ref": "gkx-common.defs.json#/$defs/componentReference"
    },
    "selected_at": {
      "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp"
    },
    "members": {
      "type": "array",
      "description": "Ordered selection result; array order is semantically significant.",
      "items": {
        "type": "object",
        "required": [
          "object_ref",
          "score_type",
          "score",
          "inclusion_reason"
        ],
        "properties": {
          "object_ref": {
            "$ref": "gkx-common.defs.json#/$defs/artifactReferenceAnyDigest"
          },
          "score_type": {
            "type": "string",
            "enum": [
              "float",
              "integer",
              "not-applicable"
            ]
          },
          "score": {
            "description": "The canonical CBOR verifier enforces the schema-declared integer/float representation; JSON Schema alone cannot distinguish every integral-valued float.",
            "type": [
              "number",
              "null"
            ]
          },
          "inclusion_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "score_type": {
                  "const": "integer"
                }
              },
              "required": [
                "score_type"
              ]
            },
            "then": {
              "properties": {
                "score": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "score_type": {
                  "const": "not-applicable"
                }
              },
              "required": [
                "score_type"
              ]
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "score_type": {
                  "const": "float"
                }
              },
              "required": [
                "score_type"
              ]
            },
            "then": {
              "properties": {
                "score": {
                  "type": "number"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "known_omissions": {
      "type": "array",
      "x-gkx-set-order": "canonical-cbor-bytewise",
      "items": {
        "type": "object",
        "required": [
          "object_ref",
          "reason"
        ],
        "properties": {
          "object_ref": {
            "$ref": "gkx-common.defs.json#/$defs/artifactReferenceAnyDigest"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "closure_inputs": {
      "type": "array",
      "x-gkx-set-order": "canonical-cbor-bytewise",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "object_ref"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contradiction",
              "warning",
              "restriction",
              "lineage"
            ]
          },
          "object_ref": {
            "$ref": "gkx-common.defs.json#/$defs/artifactReferenceAnyDigest"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
