{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/authority-receipt-1.1.0.schema.json",
  "title": "GKX Authority Receipt role 1.1.0",
  "description": "R26-S01 and R26-S07 (proposed; v0.83 development line; unpublished). Adds subject, tenant_scope, revocation.locator and review_deadline_seconds to Authority Receipt 1.0.0, which stays valid for historical receipts. review_deadline_seconds is required when the grant permits delegated actions that need review; the grant or the policy it binds may carry the deadline (R26-A14), so that condition is a semantic check, not a schema constraint.",
  "type": "object",
  "required": [
    "canonical_profile", "artifact_type", "schema_version",
    "receipt_id", "receipt_version", "issuer", "subject", "grantor", "grantee",
    "authority_source_ref", "permitted_action_classes", "effect_scope",
    "delegation_permitted", "issued_at", "valid_from", "valid_until",
    "policy_ref", "revocation", "nonce", "proof_mechanism"
  ],
  "properties": {
    "canonical_profile": { "const": "GKX-CBOR-1" },
    "artifact_type": { "const": "authority-receipt" },
    "schema_version": { "const": "1.1.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "receipt_version": { "type": "string", "minLength": 1 },
    "issuer": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "subject": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "grantor": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "grantee": { "$ref": "gkx-common.defs.json#/$defs/actorReference" },
    "authority_source_ref": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" },
    "permitted_action_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "x-gkx-set-order": "canonical-cbor-bytewise", "items": { "type": "string", "minLength": 1 } },
    "effect_scope": { "$ref": "gkx-common.defs.json#/$defs/effectScope" },
    "purpose_scope": { "type": "array", "uniqueItems": true, "x-gkx-set-order": "canonical-cbor-bytewise", "items": { "type": "string", "minLength": 1 } },
    "tenant_scope": { "type": "array", "uniqueItems": true, "x-gkx-set-order": "canonical-cbor-bytewise", "items": { "type": "string", "minLength": 1 } },
    "delegation_permitted": { "type": "boolean" },
    "issued_at": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
    "valid_from": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
    "valid_until": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
    "policy_ref": { "$ref": "gkx-common.defs.json#/$defs/componentReference" },
    "revocation": {
      "type": "object",
      "required": ["status", "checked_at", "method", "locator"],
      "properties": {
        "status": { "type": "string", "enum": ["not-revoked", "revoked", "indeterminate"] },
        "checked_at": { "$ref": "gkx-common.defs.json#/$defs/canonicalTimestamp" },
        "method": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "nonce": { "type": "string", "minLength": 1 },
    "proof_mechanism": { "type": "string", "minLength": 1 },
    "predecessor_receipt_ref": { "$ref": "gkx-common.defs.json#/$defs/artifactReference" },
    "review_deadline_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "R26-S07: maximum interval, in seconds, between a delegated action's captured commit time and its review disposition (R26-A14)."
    }
  },
  "additionalProperties": false
}
