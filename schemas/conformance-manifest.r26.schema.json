{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/conformance-manifest.r26.schema.json",
  "title": "GKOS conformance claim manifest — R26 version",
  "description": "Exact-bound machine-readable conformance claim under R16: dated standard release, GKX version, implementation, fixture suite, immutable evidence, limitations, exceptions, and assessment type. R26-S04 (accepted 2026-10-07; v0.83 development line) adds receipt_binding, canonical_rendering, supported_artifact_schemas and role_projections. Every manifest valid under conformance-manifest.schema.json is valid under this version. The obligation to declare each item comes from the requirement or annex that names it, not from this schema.",
  "type": "object",
  "required": [
    "claim_id",
    "implementation",
    "standard",
    "evidence_status",
    "requirements_verified",
    "profiles_claimed",
    "tier_claims",
    "applicability",
    "attestation",
    "fixtures",
    "evidence",
    "limitations",
    "exceptions",
    "generated_at"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": [
        "gkos_release",
        "technical_spec"
      ],
      "properties": {
        "gkos_release": {
          "type": "string",
          "examples": [
            "GKOS-2026-08-20 v0.80"
          ]
        },
        "technical_spec": {
          "type": "string",
          "examples": [
            "GKX 2.0"
          ]
        },
        "technical_spec_status": {
          "type": "string",
          "enum": [
            "ratified",
            "developmental",
            "draft"
          ]
        },
        "last_ratified_baseline": {
          "type": "string",
          "examples": [
            "GKX 2.0"
          ]
        }
      },
      "if": {
        "properties": {
          "technical_spec_status": {
            "const": "draft"
          }
        }
      },
      "then": {
        "required": [
          "last_ratified_baseline"
        ]
      },
      "additionalProperties": false
    },
    "profiles_claimed": {
      "description": "Profiles for which the cited catalog declares complete qualifying coverage and every required expectation passed. An empty array means that the run produced evidence but no profile claim.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "GCP-1",
          "GCP-2",
          "GCP-3",
          "GCP-4",
          "GCP-5",
          "GCP-6",
          "GCP-7",
          "GKOS-Core",
          "GKOS-Advanced",
          "GCP-6-Context-Only-Extension",
          "Viewer-Projection-Profile"
        ]
      }
    },
    "evidence_status": {
      "description": "Computed coverage status from the registered evidence vocabulary; assessment independence remains a separate attestation axis.",
      "type": "string",
      "enum": [
        "evidence_incomplete",
        "mechanism_demonstrated",
        "requirement_verified",
        "cumulative_profile_satisfied",
        "tier_claimable"
      ]
    },
    "requirements_verified": {
      "description": "Permanent requirements computed from catalog-declared complete fixture sets whose cited fixtures all passed.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GKOS-[A-Z]+-[0-9]{3}$"
      }
    },
    "tier_claims": {
      "description": "Named tiers computed from complete passing requirement coverage.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "GKOS-Core",
          "GKOS-Advanced",
          "GCP-6-Context-Only-Extension"
        ]
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "mapping_version",
        "mapping_sha256",
        "evidence_vocabulary_version",
        "evidence_vocabulary_sha256"
      ],
      "properties": {
        "mapping_version": {
          "type": "string"
        },
        "mapping_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_vocabulary_version": {
          "type": "string"
        },
        "evidence_vocabulary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "required": [
        "mode",
        "attested_by",
        "assessment_date"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "self-attested",
            "independently-verified"
          ]
        },
        "attested_by": {
          "type": "string"
        },
        "assessment_date": {
          "type": "string",
          "format": "date"
        },
        "verifier": {
          "type": "string"
        },
        "assessor_scope": {
          "type": "string",
          "minLength": 1
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independence_basis": {
          "type": "string",
          "minLength": 1
        },
        "tested_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "independently-verified"
          }
        }
      },
      "then": {
        "required": [
          "verifier",
          "assessor_scope",
          "methods",
          "independence_basis",
          "tested_version"
        ]
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "object",
      "required": [
        "catalog_version",
        "executed",
        "passed",
        "failed",
        "skipped",
        "results"
      ],
      "properties": {
        "catalog_version": {
          "type": "string"
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "fully_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "unevaluated": {
          "type": "integer",
          "minimum": 0
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fixture_id",
              "outcome"
            ],
            "properties": {
              "fixture_id": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skip",
                  "known-divergence",
                  "unevaluated"
                ]
              },
              "divergence_ref": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "description": "Disclosed limitations. Limitations cannot waive an applicable mandatory gate.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "description": "Immutable evidence locators and SHA-256 digests supporting the claim.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "locator",
          "sha256"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_binding": {
      "description": "GKOS-RECEIPT-003: the binding mechanism for State-Change Receipt role records and the locator of its evidence.",
      "type": "object",
      "required": [
        "mechanism",
        "evidence_locator"
      ],
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "evidence_locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "canonical_rendering": {
      "description": "Canonical Serialization annex §9: declared rendering format and version, and the verifier that accepts the rendering.",
      "type": "object",
      "required": [
        "format",
        "version",
        "verifier_locator",
        "verifier_sha256"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "verifier_locator": {
          "type": "string",
          "minLength": 1
        },
        "verifier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "supported_artifact_schemas": {
      "description": "Canonical Serialization annex §3 (R26-A08): the (artifact_type, schema_version) pairs the canonical verifier supports.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "schema_version"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "role_projections": {
      "description": "R26-A13: each declared role projection the implementation relies on. Envelope constants (canonical_profile, artifact_type, schema_version) are set by constant and never read from the source record; every other role element comes from exactly one source field by copy, wrap-set or value-table.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "role",
          "role_schema_version",
          "source_schema",
          "projection_id",
          "projection_version",
          "projection_sha256",
          "field_mappings"
        ],
        "properties": {
          "role": {
            "description": "The role schema's artifact_type, for example refusal-receipt.",
            "type": "string",
            "minLength": 1
          },
          "role_schema_version": {
            "type": "string",
            "minLength": 1
          },
          "source_schema": {
            "description": "Identifier of the source record's schema, such as its $id.",
            "type": "string",
            "minLength": 1
          },
          "projection_id": {
            "type": "string",
            "minLength": 1
          },
          "projection_version": {
            "type": "string",
            "minLength": 1
          },
          "projection_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "field_mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "role_element",
                "operation"
              ],
              "properties": {
                "role_element": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "constant",
                    "copy",
                    "wrap-set",
                    "value-table"
                  ]
                },
                "source_field": {
                  "type": "string",
                  "minLength": 1
                },
                "constant": {
                  "type": "string"
                },
                "value_table": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "source_value",
                      "role_value"
                    ],
                    "properties": {
                      "source_value": {
                        "type": "string"
                      },
                      "role_value": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "constant"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "constant"
                    ],
                    "properties": {
                      "role_element": {
                        "enum": [
                          "canonical_profile",
                          "artifact_type",
                          "schema_version"
                        ]
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "source_field"
                          ]
                        },
                        {
                          "required": [
                            "value_table"
                          ]
                        }
                      ]
                    }
                  },
                  "else": {
                    "required": [
                      "source_field"
                    ],
                    "properties": {
                      "role_element": {
                        "not": {
                          "enum": [
                            "canonical_profile",
                            "artifact_type",
                            "schema_version"
                          ]
                        }
                      }
                    },
                    "not": {
                      "required": [
                        "constant"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "value-table"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "value_table"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "value_table"
                      ]
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object"
    },
    "generated_at": {
      "$ref": "gkx-common.defs.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
