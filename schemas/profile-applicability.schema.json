{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/profile-applicability.schema.json",
  "title": "GKOS machine-readable profile applicability mapping",
  "type": "object",
  "required": ["mapping_version", "status", "authority", "gkos_release", "profiles", "requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "mapping_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-development)?$" },
    "status": { "const": "machine-readable mirror" },
    "authority": { "const": "requirements/PROFILE_APPLICABILITY.md" },
    "gkos_release": { "type": "string", "minLength": 1 },
    "qualification_boundary": { "type": "string", "minLength": 1 },
    "profiles": { "type": "object", "minProperties": 1 },
    "requirements": {
      "type": "object",
      "propertyNames": { "pattern": "^GKOS-[A-Z]+-[0-9]{3}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["profiles"],
        "properties": {
          "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "condition": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
