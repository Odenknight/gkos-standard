{
  "name": "gkos-ts-runner",
  "private": true,
  "type": "module",
  "description": "GKOS-TS starter conformance runner (adapter-neutral).",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && npm run lint:registries",
    "lint:registries": "node registry-lint.mjs",
    "lint:mutation-coverage": "node registry-lint.mjs --require-mutation-coverage",
    "gcp6:replay": "node replay-fixture.mjs --out-dir gcp6-replay-evidence",
    "srtp:draft": "node srtp-graph.mjs --out srtp-draft-report.json"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "cbor": "^10.0.11",
    "yaml": "^2.5.0"
  }
}
