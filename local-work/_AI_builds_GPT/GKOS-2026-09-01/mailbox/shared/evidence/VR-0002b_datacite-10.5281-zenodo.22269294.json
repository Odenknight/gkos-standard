{"data":{"id":"10.5281/zenodo.22269294","type":"dois","attributes":{"doi":"10.5281/zenodo.22269294","prefix":"10.5281","suffix":"zenodo.22269294","identifiers":[{"identifier":"oai:zenodo.org:22269294","identifierType":"oai"}],"alternateIdentifiers":[{"alternateIdentifierType":"oai","alternateIdentifier":"oai:zenodo.org:22269294"}],"creators":[{"name":"Marshall, Shaun Allan","nameType":"Personal","givenName":"Shaun Allan","familyName":"Marshall","nameIdentifiers":[],"affiliation":[]}],"titles":[{"title":"GKOS v0.81 — A Developmental Pre-standard for AI Governance, Accountability and Auditability"}],"publisher":"Zenodo","container":{},"publicationYear":2026,"subjects":[{"subject":"knowledge governance"},{"subject":"provenance"},{"subject":"agentic systems"},{"subject":"AI governance"},{"subject":"auditability"},{"subject":"knowledge operations"},{"subject":"GKOS"},{"subject":"GKX"},{"subject":"accountability"},{"subject":"pre-standard"},{"subject":"AI assurance"},{"subject":"authorized use"},{"subject":"evidence traceability"}],"contributors":[],"dates":[{"date":"2026-09-03","dateType":"Issued"}],"language":null,"types":{"ris":"RPRT","bibtex":"article","citeproc":"article-journal","schemaOrg":"ScholarlyArticle","resourceType":"Technical note","resourceTypeGeneral":"Text"},"relatedIdentifiers":[{"relationType":"IsSupplementTo","relatedIdentifier":"https://github.com/Odenknight/gkos-standard","relatedIdentifierType":"URL"},{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.22269293","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"0.81","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The Governed Knowledge Operations Standard (GKOS) is a developmental public pre-standard designed to support AI governance, accountability, and auditability. It defines seven cumulative responsibilities for preserving sources, governing identity and lineage, applying deterministic controls, recording authorized review, assembling purpose-bound context, and recording authorized actions or refusals. Version 0.81 consolidates captured-time authority validity, review lifecycle and protected-disclosure requirements, the eighth documentation-intent invariant, and explicit publication controls. The edition contains 62 permanent requirement allocations and 28 mandatory diagnostic gate codes. This owner-authorized v0.x publication is non-consensus and non-qualifying; it does not establish implementation certification, regulatory approval, or independently demonstrated effectiveness. Public second implementation remains awaiting. Documentation and original graphics are CC BY 4.0; schemas, fixtures, workflows, scripts, and reference code remain Apache-2.0.","descriptionType":"Abstract"},{"description":"Release-level CC BY 4.0 metadata describes the normative standard. Individual implementation artifacts remain Apache-2.0 as declared by LICENSE.md.","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://zenodo.org/doi/10.5281/zenodo.22269294","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-09-03T05:31:57.000Z","registered":"2026-09-03T05:31:57.000Z","published":"2026","updated":"2026-09-03T05:31:57.000Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}},"provider":{"data":{"id":"cern","type":"providers"}},"media":{"data":{"id":"10.5281/zenodo.22269294","type":"media"}},"references":{"data":[]},"citations":{"