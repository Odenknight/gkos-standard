%% GKOS Canonical Architecture — v0.82 candidate, draft r1 — INFORMATIVE — 2026-09-03
%% Companion to GKOS-Canonical-Architecture-v0.82-r1.svg (the SVG is the reference rendering).
flowchart TB
    STD["GKOS Governance Standard<br/><small>normative · v0.81 published 2026-09-03 · owner-authorized · non-consensus · no qualifying profile</small>"]
    GKX["GKX 2.0 Data Contracts — the interoperability seam<br/><small>exchange GKX records, fixtures, receipts — never internals · machine identifiers frozen</small>"]

    subgraph IMPL["Implementations (plural)"]
        direction LR
        ENG["GKOS-Engine 2.1.2<br/><small>reference · TypeScript · zero runtime deps · Graphiti = export adapter · under rewrite · divergences disclosed<br/>evidence: mechanism</small>"]
        KRSL["Kosmos Research Studio Lite<br/><small>candidate 2nd implementation · same author · private · not an Engine descendant<br/>evidence: interoperability</small>"]
        IMPB["Implementation B — open slot<br/><small>independent author · public source · disagreements documented<br/>evidence: independence of interpretation</small>"]
    end

    subgraph ORDER["Required order inside any conforming implementation"]
        direction LR
        RET["Retrieval<br/><small>may be wrong — allowed</small>"] --> CAND["Candidate set<br/><small>what retrieval returned</small>"] --> ELIG["Eligibility recall check<br/><small>none eligible → abstain / expand</small>"] --> GOV["Governance (L4)<br/><small>filters only · never rescores</small>"] --> CTX["Context assembly<br/><small>Context Manifest · Authorized Use</small>"]
    end

    GAB["Governed Action Boundary<br/><small>L4 admission · L7 consequential-action controls · bounded delegation ceilings<br/>fail-closed · PASS / MODIFY / REFUSE · every outcome receipted</small>"]
    LEDGER["Receipt Ledger (L6)<br/><small>append-only · hash-chained · every governed state change</small>"]
    HUM["Humans<br/><small>decision authority: HUMAN_ONLY · HUMAN_AND_AGENT · HUMAN_OR_AGENT · AGENT_ONLY<br/>observer: reads receipts, Decision Records, contradictions, supersession<br/>owner decisions (OD-series) rule; agents propose · escalation terminates here</small>"]

    subgraph BIND["Bindings — versioned · informative · non-activating (R21) · callable ≠ authorized"]
        direction LR
        MCP["MCP binding"]
        A2A["A2A binding<br/><small>delegation ≤ chain intersection</small>"]
        ACS["ACS adapter<br/><small>enforcement route, not dependency</small>"]
    end

    subgraph AGENTS["Agent classes (not products) — carry an Agent Identity Card"]
        direction LR
        RO["Read-only agents<br/><small>read_scope</small>"]
        PROP["Proposing agents<br/><small>proposal_scope · gate decides</small>"]
        DW["Delegated-write agents<br/><small>bounded delegation · ceiling</small>"]
    end

    subgraph DEPLOY["Founder deployment — informative, NOT part of the Standard"]
        direction LR
        HYP["Hypatia<br/><small>model-router gateway · raise-only classification · hash-chained audit</small>"]
        OBS["GKOS-Observatory<br/><small>public sandbox · Engine read-only · synthetic corpus</small>"]
        KO["Kosmos-Oden<br/><small>human observability UI · display grants no authority</small>"]
    end

    STD --> GKX
    GKX --> ENG & KRSL & IMPB
    IMPL --> ORDER
    ORDER -->|proposed actions, context| GAB
    GAB --> MCP & A2A & ACS
    MCP --> RO
    A2A --> PROP
    ACS --> DW
    HUM -->|authority| GAB
    GAB -.->|receipts, escalations| HUM
    GAB -.->|receipts| LEDGER
    AGENTS -.->|every agent action → receipt| LEDGER
    LEDGER -.->|receipts re-enter as GKX records| GKX

    OBS -.-> ENG
    HYP -.-> BIND
    KO -.-> HUM

    classDef norm fill:#1f3a5f,color:#fff,stroke:#1f3a5f
    classDef seam fill:#245c5c,color:#fff,stroke:#245c5c
    classDef impl fill:#3b6fb6,color:#fff,stroke:#3b6fb6
    classDef open fill:#fbfaf7,color:#3b6fb6,stroke:#3b6fb6,stroke-dasharray:6 4
    classDef pipe fill:#dbe7f6,color:#1f2937,stroke:#3b6fb6
    classDef gate fill:#b5541c,color:#fff,stroke:#b5541c
    classDef ledger fill:#5b3f2e,color:#fff,stroke:#5b3f2e
    classDef human fill:#5b3b7a,color:#fff,stroke:#5b3b7a
    classDef bind fill:#f3f4f6,color:#374151,stroke:#6b7280,stroke-dasharray:6 4
    classDef agent fill:#4f7942,color:#fff,stroke:#4f7942
    classDef dep fill:#fbfaf7,color:#5c554b,stroke:#9c948a
    class STD norm
    class GKX seam
    class ENG,KRSL impl
    class IMPB open
    class RET,CAND,ELIG,GOV,CTX pipe
    class GAB gate
    class LEDGER ledger
    class HUM human
    class MCP,A2A,ACS bind
    class RO,PROP,DW agent
    class HYP,OBS,KO dep
    style DEPLOY fill:#efece4,stroke:#9c948a,stroke-dasharray:8 5
