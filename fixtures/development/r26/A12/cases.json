{
  "suite": "GKOS-v0.83-development-R26-A12-state-change-receipt-role-elements",
  "standing": "Development fixtures for proposed R26-A12. Non-qualifying. Each case gives a candidate record under its own field names, a role_field_map from R26-A12 role elements to those fields, and the change context that makes conditional elements required.",
  "requirement_refs": [
    "GKOS-RECEIPT-001",
    "GKOS-RECEIPT-002",
    "GKOS-RECEIPT-003"
  ],
  "role_elements": {
    "always": [
      "identity",
      "version",
      "actor_ref",
      "actor_class",
      "operation",
      "outcome",
      "binding_mechanism",
      "binding_identifier",
      "captured_time"
    ],
    "when_requires_authority": [
      "authority_basis_ref"
    ],
    "when_policy_took_part": [
      "policy_identity",
      "policy_version",
      "policy_digest"
    ],
    "when_predicate_consulted": [
      "predicate_identity",
      "predicate_version",
      "nondeterministic_checker_increased_restrictiveness"
    ],
    "unless_creation": [
      "before_state_ref"
    ],
    "after_state": "after_state_ref, or tombstone_ref when deletion_or_erasure",
    "outcome_values": [
      "committed",
      "rolled-back",
      "compensated",
      "refused"
    ],
    "digest_bound": [
      "before_state_ref",
      "after_state_ref",
      "tombstone_ref"
    ]
  },
