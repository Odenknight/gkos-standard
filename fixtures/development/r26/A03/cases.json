      "case_id": "R26-A03-05",
      "title": "Empty interval: valid_from equals valid_until",
      "evaluation_time": "2026-10-01T13:00:00.000000Z",
      "chain": [
        {
          "receipt_id": "fixture:r26-authority-root",
