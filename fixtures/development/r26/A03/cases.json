    {
      "case_id": "R26-A03-06",
      "title": "issued_at after evaluation time is not a validity bound",
      "evaluation_time": "2026-10-01T13:00:00.000000Z",
      "chain": [
        {
          "receipt_id": "fixture:r26-authority-root",
          "issued_at": "2026-10-01T09:00:00.000000Z",
          "valid_from": "2026-10-01T10:00:00.000000Z",
          "valid_until": "2026-10-01T20:00:00.000000Z"
        },
        {
          "receipt_id": "fixture:r26-authority-leaf",
          "issued_at": "2026-10-01T13:30:00.000000Z",
          "valid_from": "2026-10-01T12:00:00.000000Z",
          "valid_until": "2026-10-01T18:00:00.000000Z"
        }
      ],
      "expected": {
        "outcome": "admit"
      },
      "reason": "issued_at records issuance; it is not a validity bound (R26-A03). Whether a receipt issued after the evaluation time is otherwise acceptable is outside R26-A03.",
