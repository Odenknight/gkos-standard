      "description": "evaluation one microsecond before the deadline; review pending: not overdue",
      "record": {
        "kind": "deferred-review",
        "delegation_ref": "delegation:r26-a14",
        "review_deadline_seconds": 86400,
        "actions": [
          {
            "action_ref": "action:1",
            "commit_time": "2026-10-01T00:00:00.000000Z",
            "review_status": "pending"
          }
        ],
        "evaluation_time": "2026-10-01T23:59:59.999999Z",
        "exception": null
      },
      "expected": {
        "authorizes_state_change": true,
        "gate_code": null
